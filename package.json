{
  "name": "arsenal_malmo_league_standings",
  "version": "1.0.0",
  "description": "Use chart.js to display historical league positions",
  "main": "dist/server.js",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git@github.com:thulin82/arsenal_malmo_league_standings.git"
  },
  "author": "thulin82",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.0",
    "chart.js": "^3.8.0",
    "cors": "^2.8.0",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "xml2js": "^0.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.0",
    "@types/node": "^22.0.0",
    "@types/xml2js": "^0.4.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.9.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.0"
  },
  "scripts": {
    "build": "tsc && npm run build:copy-public",
    "build:copy-public": "npm run compile:frontend",
    "compile:frontend": "tsc --project tsconfig.frontend.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "cross-env CI=true vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  }
}
